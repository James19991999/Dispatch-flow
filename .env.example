# ── Firebase client SDK (safe to expose in the browser) ─────────────────────
# From Firebase Console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server-only, never expose) ──────────────────────────
# From Firebase Console → Project settings → Service accounts → Generate new
# private key. Either paste the whole JSON as one line into
# FIREBASE_SERVICE_ACCOUNT_KEY, OR fill the three split vars below — not both.
FIREBASE_SERVICE_ACCOUNT_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── IntaSend billing (optional — app runs fully featured without it) ───────
# From your IntaSend dashboard → API Settings. Card payments work with a USD
# checkout; M-Pesa STK Push requires a KES checkout (Kenya-only).
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
# Set the same string in IntaSend's dashboard under Webhooks → Challenge.
# See src/app/api/webhooks/intasend/route.ts for why this (not an HMAC
# signature) is IntaSend's verification model.
INTASEND_WEBHOOK_CHALLENGE=
# "true" to hit IntaSend's live API instead of the sandbox.
INTASEND_LIVE=false
# Used to build the checkout redirect URL server-side. Defaults to the
# request's own origin if unset (fine for most deployments).
NEXT_PUBLIC_APP_URL=
